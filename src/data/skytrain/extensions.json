    },
    {
      "id": "newton",
      "name": "King George Boulevard to Newton",
      "line": "expo",
      "detail": "Surrey council wants to extend the Expo Line south along King George Boulevard. The province has pledged support. Funding, station sites and the connection to the existing line are still open.",
      "sources": [
        "newton",
        "newtprem"
      ],
      "geometry": "The dotted line follows King George Boulevard.",
      "archive": false
    },
    {
      "id": "poco",
      "name": "Port Coquitlam extension",
      "line": "millennium",
      "detail": "Port Coquitlam and TransLink have worked on a business plan for a Millennium Line branch near Coquitlam Central. Station sites and construction funding remain undecided.",
      "sources": [
        "pocorelease",
