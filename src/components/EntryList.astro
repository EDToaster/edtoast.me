---
/*
  The listing used for games and demos. Deliberately a list with hairlines,
  not a grid of cards.
*/
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: (CollectionEntry<"games"> | CollectionEntry<"demos">)[];
  empty: string;
}
const { entries, empty } = Astro.props;
const sorted = [...entries].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const fmt = (d: Date) => d.toISOString().slice(0, 7);
---

{
  sorted.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ol class="list">
      {sorted.map((e) => (
        <li>
          <time class="mono" datetime={e.data.date.toISOString()}>
            {fmt(e.data.date)}
          </time>
          <div>
            <a href={e.data.href ?? `/${e.collection}/${e.id}`}>{e.data.title}</a>
            {e.data.status !== "playable" && <span class="status mono">{e.data.status}</span>}
            <p>{e.data.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  )
}

<style>
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: var(--rule-width) solid var(--rule);
  }
  li:last-child {
    border-bottom: var(--rule-width) solid var(--rule);
  }
  time {
    color: var(--ink-soft);
    font-size: 0.8rem;
    padding-top: 0.3em;
  }
  li a {
    font-weight: 600;
  }
  li p {
    margin: var(--space-1) 0 0;
    color: var(--ink-soft);
    font-size: var(--step--1);
  }
  .status {
    margin-left: var(--space-2);
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .empty {
    color: var(--ink-soft);
  }
  @media (max-width: 30rem) {
    li {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }
</style>
