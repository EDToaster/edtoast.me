---
/* Listing for games and demos, styled like the project list. */
import type { CollectionEntry } from "astro:content";

interface Props {
  entries: (CollectionEntry<"games"> | CollectionEntry<"demos">)[];
  empty: string;
}
const { entries, empty } = Astro.props;
const sorted = [...entries].sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

{
  sorted.length === 0 ? (
    <p class="empty">{empty}</p>
  ) : (
    <ul class="entries">
      {sorted.map((e) => (
        <li>
          <a class="entry" href={e.data.href ?? `/${e.collection}/${e.id}`}>
            <div class="entry-name">
              {e.data.title}
              <span class="kind">{e.collection === "games" ? "game" : "demo"}</span>
            </div>
            {e.data.tags.length > 0 && (
              <div class="tags">
                {e.data.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
                {e.data.status !== "playable" && <span class="tag">{e.data.status}</span>}
              </div>
            )}
            <p class="desc">{e.data.summary}</p>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .entries {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .entry {
    display: block;
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s;
  }
  .entry:hover {
    border-color: var(--border-strong);
  }
  .entry-name {
    font-weight: 600;
    font-size: var(--text-base);
    margin-bottom: 0.4rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
  }
  .kind {
    font-weight: 400;
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.55rem;
  }
  .desc {
    font-size: var(--text-md);
    color: var(--muted);
    line-height: 1.5;
  }
  .empty {
    color: var(--muted);
    font-size: var(--text-md);
  }
</style>
