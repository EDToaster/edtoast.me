<button type="button" class="glass-toggle" data-glass-toggle aria-pressed="false" title="Glass cursor (Esc to turn off)" hidden>
  <span class="indicator" aria-hidden="true"></span>Glass cursor
</button>

<style>
  .glass-toggle:not([hidden]) {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    border: 0;
    background: none;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
  }
  .glass-toggle:hover { color: var(--text); }
  .glass-toggle[aria-pressed="true"] { color: var(--accent); }
  .indicator {
    width: 0.8em;
    height: 0.8em;
    border: 1px solid currentColor;
    border-radius: 50%;
  }
  [aria-pressed="true"] .indicator {
    background: currentColor;
    box-shadow: inset 0 0 0 2px var(--bg);
  }
</style>
