---
import { getCollection } from "astro:content";
import { faGithub } from "@fortawesome/free-brands-svg-icons";
import Base from "~/layouts/Base.astro";
import Icon from "~/components/Icon.astro";
import CompanyLogo from "~/components/CompanyLogo.astro";
import EntryList from "~/components/EntryList.astro";
import { site, heroLinks } from "~/data/site";
import { roles, education, stats, skills, emphasize } from "~/data/resume";
import { projects } from "~/data/projects";

const play = [...(await getCollection("games")), ...(await getCollection("demos"))];

const sections = [
  { id: "hero", label: "Intro" },
  { id: "work", label: "Work" },
  { id: "education", label: "Education" },
  { id: "projects", label: "Projects" },
  { id: "play", label: "Games & demos" },
];
---

<Base home>
  <nav class="dot-nav" aria-label="Page sections">
    {
      sections.map((s, i) => (
        <a class:list={["dot-item", { active: i === 0 }]} href={`#${s.id}`}>
          <span class="dot-label">{s.label}</span>
          <span class="dot" aria-hidden="true" />
        </a>
      ))
    }
  </nav>

  <section id="hero">
    <div class="section-content">
      <h1 class="hero-name">{site.name}</h1>
      <p class="hero-title">
        {site.title} &middot;
        <span class="employer"><CompanyLogo company="perplexity" />{site.employer}</span>
      </p>
      <div class="hero-links">
        {
          heroLinks.map((l) =>
            l.href ? (
              <a href={l.href} rel="me noopener" target="_blank">
                <Icon icon={l.icon} /> {l.label}
              </a>
            ) : (
              <span>
                <Icon icon={l.icon} /> {l.label}
              </span>
            ),
          )
        }
      </div>
    </div>
  </section>

  <section id="work">
    <div class="section-content">
      <p class="section-label">Work</p>
      <ul class="stats">
        {
          stats.map((s) => (
            <li class="stat">
              <div class="stat-value">{s.value}</div>
              <div class="stat-label">{s.label}</div>
              <div class="stat-where">{s.where}</div>
            </li>
          ))
        }
      </ul>
      <ul class="timeline">
        {
          roles.map((r) => (
            <li class="timeline-item">
              <span class="timeline-date">{r.period}</span>
              <div class:list={["timeline-body", { current: r.current, upcoming: r.upcoming }]}>
                <div class="timeline-company">
                  {r.logo && <CompanyLogo company={r.logo} />}
                  <span>{r.company}</span>
                  {r.upcoming && <span class="tag">Upcoming</span>}
                </div>
                <div class="timeline-role">
                  {r.title}
                  {r.location && <span class="timeline-loc">{r.location}</span>}
                </div>
                {r.highlights || r.features ? (
                  <details class="timeline-details">
                    <summary>
                      <span>{r.summary}</span>
                      <span class="toggle" aria-hidden="true">
                        <span class="toggle-more">More</span>
                        <span class="toggle-less">Less</span>
                      </span>
                    </summary>
                    {r.highlights && (
                      <ul class="highlights">
                        {r.highlights.map((h) => (
                          <li set:html={emphasize(h)} />
                        ))}
                      </ul>
                    )}
                    {r.features && (
                      <div class="timeline-features">
                        {r.features.map((f) => (
                          <div class="timeline-feature">
                            {f.text}
                            {f.refs && (
                              <>
                                {" — "}
                                {f.refs.map((ref, i) => (
                                  <>
                                    {i > 0 && ", "}
                                    <a class="link" href={ref.href} target="_blank" rel="noopener">
                                      {ref.label}
                                    </a>
                                  </>
                                ))}
                              </>
                            )}
                          </div>
                        ))}
                      </div>
                    )}
                    {r.stack && (
                      <div class="stack">
                        {r.stack.map((t) => (
                          <span class="tag">{t}</span>
                        ))}
                      </div>
                    )}
                  </details>
                ) : (
                  r.summary && <p class="timeline-summary">{r.summary}</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
      <div class="toolbox">
        <p class="section-label">Toolbox</p>
        <div class="stack">
          {
            skills.map((t) => (
              <span class="tag">{t}</span>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="education">
    <div class="section-content">
      <p class="section-label">Education</p>
      {
        education.map((e) => (
          <div class="edu-item">
            {e.lines.map((l) => (
              <div class="edu-degree">{l}</div>
            ))}
            <div class="edu-school">{e.school}</div>
            <div class="edu-year">{e.year}</div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="projects">
    <div class="section-content">
      <p class="section-label">Projects</p>
      <ul class="project-list">
        {
          projects.map((p) => (
            <li class="project-item">
              <div class="project-name">{p.name}</div>
              <div class="project-tags">
                {p.tags.map((t) => (
                  <span class="tag">{t}</span>
                ))}
              </div>
              <p class="project-desc">{p.description}</p>
              {p.highlights && (
                <ul class="project-highlights">
                  {p.highlights.map((h) => (
                    <li set:html={h.replace(/`([^`]+)`/g, "<code>$1</code>")} />
                  ))}
                </ul>
              )}
              {p.image && (
                <img
                  class="project-shot"
                  src={p.image.src}
                  alt={p.image.alt}
                  width={p.image.width}
                  height={p.image.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="project-links">
                {p.links.map((l) => (
                  <a class="link" href={l.href} target="_blank" rel="noopener">
                    <Icon icon={faGithub} /> {l.label}
                  </a>
                ))}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="play">
    <div class="section-content">
      <p class="section-label">Games &amp; demos</p>
      <EntryList entries={play} empty="Nothing here yet." />
      <p class="more">
        <a class="link" href="/games">All games</a>
        <a class="link" href="/demos">All demos</a>
        <a class="muted" href="https://github.com/EDToaster/edtoast.me">source</a>
      </p>
    </div>
  </section>
</Base>

<script>
  const dots = document.querySelectorAll<HTMLAnchorElement>(".dot-item");
  const sections = [...document.querySelectorAll<HTMLElement>("main > section")];
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        const i = sections.indexOf(entry.target as HTMLElement);
        dots.forEach((d, j) => d.classList.toggle("active", i === j));
      }
    },
    { threshold: 0.5 },
  );
  sections.forEach((s) => observer.observe(s));
</script>

<style is:global>
  html.home {
    scroll-snap-type: y proximity;
    scroll-behavior: smooth;
  }
</style>

<style>
  section {
    min-height: 100vh;
    scroll-snap-align: start;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
  }
  .section-content {
    width: 100%;
    max-width: var(--content);
  }

  /* Dot nav — dots only at rest; on hover, labels slide out and dots magnify like the macOS Dock */
  .dot-nav {
    position: fixed;
    right: 1.75rem;
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    z-index: 10;
  }
  .dot-item {
    --scale: 1;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    /* Padding (not margin) so each link's hit area fills its whole row; neighbours touch with no dead zone */
    height: 7px;
    box-sizing: content-box;
    padding: 0.3rem 0;
    transition: padding 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1.5px solid var(--muted);
    transform: scale(var(--scale));
    transition:
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      background 0.2s,
      border-color 0.2s;
  }
  .dot-item.active .dot {
    background: var(--text);
    border-color: var(--text);
  }
  .dot-label {
    /* Spans the full row height and runs right up to the dot, so the label-to-dot gap is clickable too */
    position: absolute;
    top: 0;
    bottom: 0;
    right: 100%;
    display: flex;
    align-items: center;
    padding: 0 0.5rem 0 0.75rem;
    white-space: nowrap;
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    opacity: 0;
    transform: translateX(6px) scale(0.92);
    transform-origin: right center;
    pointer-events: none;
    transition:
      opacity 0.2s,
      transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1),
      color 0.15s;
  }
  .dot-item.active .dot-label {
    color: var(--text);
  }

  /* Expanded state */
  .dot-nav:hover .dot-item,
  .dot-nav:focus-within .dot-item {
    padding: 0.55rem 0;
  }
  .dot-nav:hover .dot-label,
  .dot-nav:focus-within .dot-label {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  .dot-nav:hover .dot-item:hover .dot-label,
  .dot-item:focus-visible .dot-label {
    color: var(--text);
    transform: scale(1.08);
  }

  /* Dock-style magnification: hovered dot biggest, neighbours slightly larger */
  .dot-nav:hover .dot-item {
    --scale: 1.15;
  }
  .dot-nav .dot-item:has(+ .dot-item:hover),
  .dot-nav .dot-item:hover + .dot-item {
    --scale: 1.4;
  }
  .dot-nav .dot-item:hover,
  .dot-nav .dot-item:focus-visible {
    --scale: 1.8;
  }

  @media (prefers-reduced-motion: reduce) {
    .dot-item,
    .dot,
    .dot-label {
      transition: opacity 0.15s;
    }
  }

  /* Hero */
  .hero-name {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--text-hero);
    letter-spacing: 0.02em;
    line-height: 1.05;
    margin-bottom: 0.6rem;
  }
  .hero-title {
    font-size: var(--text-base);
    color: var(--muted);
    margin-bottom: 2.25rem;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .employer {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text);
    font-weight: 500;
  }
  .employer :global(.logo) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .hero-links {
    display: flex;
    gap: var(--space-4);
    align-items: center;
    flex-wrap: wrap;
  }
  .hero-links a,
  .hero-links span {
    color: var(--muted);
    font-size: var(--text-md);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    transition: color 0.15s;
  }
  .hero-links a:hover {
    color: var(--text);
  }

  /* Timeline */
  .timeline {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .timeline-item {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 0 1.25rem;
  }
  .timeline-date {
    font-size: 0.78rem;
    color: var(--muted);
    text-align: right;
    padding-top: 0.15rem;
    line-height: 1.4;
  }
  .timeline-body {
    padding-left: 1rem;
    border-left: 2px solid var(--border);
  }
  .timeline-body.current {
    border-left-color: var(--accent);
  }
  .timeline-body.upcoming {
    border-left: 2px dashed var(--accent);
  }
  .timeline-company .tag {
    font-weight: 400;
  }
  .timeline-company {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.3rem;
    font-weight: 600;
    font-size: var(--text-base);
  }
  .timeline-role {
    font-size: var(--text-md);
    color: var(--muted);
  }
  .timeline-features {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.6rem;
  }
  .timeline-feature {
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.4;
  }

  /* Work: headline stat tiles */
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    margin-bottom: var(--space-5);
  }
  .stat {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 0.85rem;
  }
  .stat-value {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.85rem;
    line-height: 1;
    margin-bottom: 0.45rem;
  }
  .stat-label {
    font-size: 0.75rem;
    color: var(--muted);
    line-height: 1.35;
  }
  .stat-where {
    font-size: var(--text-xs);
    color: var(--muted);
    margin-top: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Work: expandable role details */
  .timeline-loc::before {
    content: " · ";
  }
  .timeline-summary,
  .timeline-details summary {
    margin-top: 0.4rem;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.45;
  }
  .timeline-details summary {
    list-style: none;
    cursor: pointer;
  }
  .timeline-details summary::-webkit-details-marker {
    display: none;
  }
  .timeline-details[open] summary {
    color: var(--text);
  }
  .toggle {
    margin-left: 0.5rem;
    color: var(--accent);
    font-size: 0.78rem;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .toggle::after {
    content: " ▾";
  }
  .timeline-details[open] .toggle::after {
    content: " ▴";
  }
  .toggle-less,
  .timeline-details[open] .toggle-more {
    display: none;
  }
  .timeline-details[open] .toggle-less {
    display: inline;
  }
  summary:hover .toggle {
    opacity: 0.75;
  }
  .highlights {
    margin-top: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .highlights li {
    position: relative;
    padding-left: 0.9rem;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.45;
  }
  .highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border-strong);
  }
  .highlights :global(strong) {
    color: var(--text);
    font-weight: 600;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.7rem;
  }
  .toolbox {
    margin-top: var(--space-5);
  }
  .toolbox .section-label {
    margin-bottom: 0.75rem;
  }

  /* Education */
  .edu-item {
    padding-left: 1rem;
    border-left: 2px solid var(--border);
  }
  .edu-degree {
    font-weight: 600;
    font-size: var(--text-base);
    margin-bottom: 0.2rem;
  }
  .edu-school {
    font-size: var(--text-md);
    color: var(--muted);
    margin-bottom: 0.2rem;
  }
  .edu-year {
    font-size: 0.78rem;
    color: var(--muted);
  }

  /* Projects */
  .project-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .project-item {
    padding: 1.1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s;
  }
  .project-item:hover {
    border-color: var(--border-strong);
  }
  .project-name {
    font-weight: 600;
    font-size: var(--text-base);
    margin-bottom: 0.4rem;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-bottom: 0.55rem;
  }
  .project-desc {
    font-size: var(--text-md);
    color: var(--muted);
    line-height: 1.5;
    margin-bottom: 0.65rem;
  }
  .project-highlights {
    list-style: disc;
    padding-left: 1.1rem;
    margin: -0.25rem 0 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-size: var(--text-sm);
    color: var(--muted);
    line-height: 1.5;
  }
  .project-highlights :global(code) {
    font-size: 0.9em;
    padding: 0.05em 0.3em;
    border-radius: var(--radius-sm);
    background: var(--surface);
    color: var(--text);
  }
  .project-shot {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .project-links {
    display: flex;
    gap: var(--space-3);
    font-size: 0.8rem;
  }
  .project-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  /* Play */
  .more {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-4);
    font-size: var(--text-md);
  }
  .muted {
    color: var(--muted);
    margin-left: auto;
  }
  .muted:hover {
    color: var(--text);
  }

  @media (max-width: 520px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-name {
      font-size: 2.5rem;
    }
    .timeline-item {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }
    .timeline-date {
      text-align: left;
    }
    .timeline-body {
      padding-left: 0.75rem;
    }
    .dot-nav {
      display: none;
    }
    section {
      padding: 3rem 1.5rem;
    }
  }
</style>
